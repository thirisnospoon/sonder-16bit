// Обогащение событий, версия 1.
//
// events дренирует outbox и синхронно спрашивает у core недостающие
// подробности события. Если core недоступен, дренаж честно останавливается
// и ретраится, а не пишет неполные проекции (ADR-0004).
//
// ВАЖНО, выяснено прогоном: тип string в CORBA байтовый и ограничен
// согласованной кодировкой передачи. Кириллица в него не проходит — вызов
// падает с DATA_CONVERSION уже в рантайме, на реальных данных, а не при
// компиляции. Любое поле с человеческим текстом обязано быть wstring.
// Идентификаторы остаются string: они ASCII по контракту.

module sonder {
  module enrichment {

    struct PostView {
      string    postId;        // ASCII по контракту
      wstring   authorNick;    // может содержать не-ASCII
      wstring   body;          // произвольный пользовательский текст
      long long createdAtMillis;
    };

    // Ограниченная выборка постов одного автора. Нужна ровно один раз —
    // когда заводится подписка и ленту надо наполнить тем, что уже
    // написано.
    typedef sequence<PostView> PostViews;

    exception NotFound {
      string id;
    };

    interface Enrichment {
      PostView loadPost(in string postId) raises (NotFound);

      // Недавние посты автора, новыми вперёд.
      //
      // ПОЧЕМУ ЭТА ОПЕРАЦИЯ ЕСТЬ, А «ДАЙ ПОДПИСЧИКОВ» НЕТ. Здесь длина
      // ограничена вызывающим и сервером, а зовётся операция раз на
      // подписку — событие редкое. Список подписчиков был бы
      // неограниченным и понадобился бы на КАЖДЫЙ пост, то есть упёрся
      // бы в измеренный потолок дренажа (ADR-0016).
      PostViews recentPostsBy(in string authorId, in long limit);

      // Дешёвый вызов для замера круговой задержки без полезной нагрузки.
      long ping(in long seq);

      // Отдельная проверка границы кодировок: возвращает то, что дали.
      wstring echoText(in wstring text);
    };

  };
};
