#!/usr/bin/env bash
# Sonder — единая точка входа.
#
#   ./sonder bootstrap   собрать образы тулчейна
#   ./sonder verify      прогнать все проверки, как в CI
#   ./sonder spikes      прогнать спайки фазы 0
#   ./sonder soak        долгий фаззинг XML и кадров
#   ./sonder help        список целей
#
# Из зависимостей нужен только Docker: весь тулчейн живёт в образах, на хосте
# не устанавливается ничего. Скрипт, а не Makefile, потому что make — это уже
# зависимость, которой на чистой машине может не оказаться, а bash есть везде,
# где есть Docker. Makefile остаётся тонкой обёрткой над этим файлом.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

DOS_IMAGE="sonder/dos-toolchain:3.2.2"
PY_IMAGE="sonder/contracts:1"

run_dos()  { docker run --rm -v "$ROOT:/work" -w /work "$DOS_IMAGE" "$@"; }
run_py()   { docker run --rm -v "$ROOT:/work" -w /work "$PY_IMAGE"  "$@"; }

step() { echo; echo "==> $*"; }
die()  { echo "ОШИБКА: $*" >&2; exit 1; }

need_docker() {
  command -v docker >/dev/null 2>&1 || die "нужен docker"
  docker info >/dev/null 2>&1 || die "docker недоступен"
}

have_image() { docker image inspect "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------- bootstrap

cmd_image_dos() {
  step "образ тулчейна DOS (кросс-компилятор FPC i8086-msdos)"
  DOCKER_BUILDKIT=1 docker build -f ops/toolchain/Dockerfile -t "$DOS_IMAGE" . \
    || die "не собрался образ тулчейна"
}

cmd_image_contracts() {
  step "образ для проверки контрактов"
  printf 'FROM python:3.12-slim\nRUN pip install --no-cache-dir pyyaml\nWORKDIR /work\n' \
    | docker build -q -t "$PY_IMAGE" -f - . > /dev/null \
    || die "не собрался образ контрактов"
  echo "    $PY_IMAGE"
}

cmd_bootstrap() {
  need_docker
  cmd_image_contracts
  cmd_image_dos
  echo
  echo "готово: образы собраны"
}

ensure_py()  { have_image "$PY_IMAGE"  || cmd_image_contracts; }
ensure_dos() { have_image "$DOS_IMAGE" || cmd_image_dos; }

# ----------------------------------------------------------------- проверки

# Разработка на Windows, исполнение в Linux-контейнерах: shell-скрипт с CRLF
# там не запускается вовсе (docs/RISKS.md, R10).
cmd_check_eol() {
  step "переводы строк"
  # Список файлов берётся у самого git, а не дублируется здесь. Раньше он был
  # вписан в эту функцию вторым экземпляром и разошёлся с .gitattributes:
  # markdown из-под проверки выпал и набрал CRLF во всех документах.
  # Разошедшиеся списки — тот же класс дефекта, что и разошедшийся с кодом
  # документ, и ловится он так же плохо.
  #
  # Шаблон задаётся через printf, а не ANSI-C-кавычками: их разворачивает не
  # всякая оболочка, а неразвёрнутые дают ПУСТОЙ шаблон, под который подходит
  # любой файл. Проверка тогда не молчит вхолостую, а срабатывает на всём
  # подряд, и отличить это от настоящей поломки с одного взгляда нельзя.
  local cr
  cr="$(printf '\015')"
  # Отбор идёт по признаку ТЕКСТОВОСТИ, а не по eol. В .gitattributes
  # стоит `* text=auto eol=lf`, и eol остаётся выставленным даже у файлов,
  # помеченных binary: проверка полезла бы в эталонные кадры линии и
  # нашла бы там байт 0x0D, потому что это байт данных, а не перевод
  # строки.
  # НОВЫЕ ФАЙЛЫ ТОЖЕ. `git ls-files` без флагов перечисляет только
  # отслеживаемые, и файл, добавленный в этом же изменении, проверку
  # проходил — а после коммита начинал её ронять. Дефект при этом никуда
  # не девался: он откладывался до следующего прогона и всплывал уже без
  # связи с тем, кто его завёл. Ровно так и вышло с панелью Grafana.
  #
  # `--exclude-standard` не пускает сюда игнорируемое: сборочные
  # каталоги, node_modules и отчёты прогонов проверять незачем.
  # `core.quotepath=false` — И БЕЗ НЕГО ПРОВЕРКА ПРОПУСКАЕТ ФАЙЛЫ.
  #
  # По умолчанию git ЭКРАНИРУЕТ не-ASCII пути в выводе: имя
  # `проба.json` приезжает как `"\320\277\321\200..."`. Такого пути на
  # диске нет, `[ -f "$f" ]` ложно, и файл молча выпадает — то есть
  # проверка отвечает «все LF», не посмотрев на него вовсе.
  #
  # Отслеживаемых файлов с русскими именами сейчас нет ни одного, и
  # потому дыра не срабатывала. В проекте, где кириллицей написано всё
  # остальное, ждать первого такого файла — вопрос времени, а
  # проверка, тихо пропускающая файлы, хуже отсутствующей.
  #
  # Имя с переводом строки внутри всё равно сломает разбор; такие
  # имена git позволяет, а здравый смысл нет.
  local bad
  bad=$(git -c core.quotepath=false ls-files --cached --others --exclude-standard \
        | git -c core.quotepath=false check-attr --stdin text \
        | sed -n 's/: text: \(auto\|set\)$//p' \
        | while IFS= read -r f; do
            if [ -f "$f" ] && grep -qU "$cr" "$f"; then echo "$f"; fi
          done)
  if [ -n "$bad" ]; then
    # Ищется БАЙТ CR, а не пара CRLF, и сообщение обязано говорить именно
    # это. Живой 0x0D в текстовом файле бывает не только от Windows: он
    # заводится, когда `\r` в кавычках теряет обратный слэш по дороге —
    # heredoc так делает регулярно, и получившийся файл работает,
    # выглядит правильно и краснеет здесь. Сказать «CRLF» значило бы
    # отправить читателя искать не то.
    echo "    файлы с байтом CR (0x0D), а по .gitattributes ожидается LF:"
    echo "$bad" | sed 's/^/      /'
    echo "    если это перевод строки: git add --renormalize . && git checkout -- ."
    echo "    если байт внутри кавычек: вернуть два символа \\r"
    return 1
  fi
  echo "    все LF"
}


cmd_contracts() {
  ensure_py
  step "проверка контрактов"
  run_py python tools/validate-contracts/validate.py
}

cmd_contracts_selftest() {
  ensure_py
  step "самопроверка валидатора контрактов"
  run_py python tools/validate-contracts/selftest.py
}

# --------------------------------------------------------------- кодогенерация

cmd_codegen() {
  ensure_py
  step "коды отказа на три языка"
  run_py python tools/gen-errors/gen_errors.py || return 1
  step "границы домена"
  run_py python tools/gen-limits/gen_limits.py || return 1
  step "стабы Pascal из WSDL"
  run_py python tools/wsdl2pas/wsdl2pas.py || return 1
  # Эталонные кадры порождает НАСТОЯЩИЙ кодировщик ядра, поэтому здесь
  # нужен образ тулчейна, а не питона. Устаревший эталон опаснее
  # отсутствующего: проверка на стороне Java осталась бы зелёной,
  # сверяясь с прошлым.
  ensure_dos
  step "эталонные кадры линии"
  run_dos bash ops/ci/gen-frames.sh || return 1
  step "эталонные ответы ядра"
  run_dos bash ops/ci/gen-replies.sh || return 1

  # Корпус решений о создании поста — из НАСТОЯЩЕГО DecideCreatePost.
  # Второе мнение на Прологе сверяется не с текстом правил, а с тем, что
  # ядро решило; устаревший корпус оставил бы проверку зелёной,
  # сверяющейся с прошлым (ADR-0022).
  step "корпус решений домена"
  run_dos bash ops/ci/gen-domain-cases.sh || return 1

  step "типы веба из OpenAPI"
  run_py python tools/gen-api-types/gen_api_types.py || return 1

  step "типы событий для веба"
  run_py python tools/gen-api-types/gen_events.py || return 1

  # Разметка записи свода: копибук COBOL и писатель на Java. Разойдись
  # они — программа прочитает мусор и не заметит: у файла фиксированной
  # ширины нет ни разделителей, ни заголовков (ADR-0018).
  step "разметка записи свода"
  run_py python tools/gen-copybook/gen_copybook.py || return 1

  # Проверка длины записи на Brainfuck. Длину диктует тот же контракт,
  # что и разметку: написанная в программе руками, она разошлась бы с
  # ним молча, и проверка длины стерегла бы прошлое (ADR-0019).
  step "проверка длины записи на Brainfuck"
  run_py python tools/gen-reclen/gen_reclen.py || return 1
}

# Сгенерированный код лежит в репозитории, чтобы его было видно на ревью.
# Значит он обязан совпадать с тем, что порождается из контрактов прямо сейчас.
#
# Что именно сверять, говорят сами генераторы: каждый печатает строку на
# каждый написанный файл. Раньше здесь стоял список каталогов, а среди них
# — весь core/src/main/java, где сгенерирован ровно один файл из полусотни.
# Любая рукописная правка объявлялась «расхождением с контрактами»: проверка
# врала о причине и не могла стать зелёной раньше коммита, хотя дисциплина
# требует ровно обратного порядка.
cmd_check_drift() {
  step "дрейф сгенерированного кода"

  local out
  if ! out="$(cmd_codegen 2>&1)"; then
    echo "$out" | sed 's/^/    /'
    return 1
  fi

  local files=()
  local line
  while IFS= read -r line; do
    [ -n "$line" ] && files+=("$line")
  # Both spellings while the move to English is under way: generators
  # cross over one at a time, and a pattern that knew only one of the two
  # would silently stop seeing half the files. A drift check that sees
  # nothing is green and means nothing. The Russian half goes with the
  # last Russian generator (ADR-0023).
  done < <(echo "$out" |
           sed -n 's/^  \([^ ].*\)  \(изменён\|без изменений\|changed\|unchanged\)$/\1/p')

  # Проверка, которой нечего сверять, зелена всегда и не значит ничего.
  if [ "${#files[@]}" -eq 0 ]; then
    echo "    генераторы не назвали ни одного файла — сверять нечего"
    return 1
  fi

  # Не git diff, а git status: новый сгенерированный файл ещё не под
  # версией, и diff его не увидел бы — а это ровно тот случай, ради
  # которого проверка и написана.
  local dirty
  dirty="$(git status --porcelain -- "${files[@]}" 2>/dev/null)"
  if [ -n "$dirty" ]; then
    echo "    сгенерированный код разошёлся с контрактами:"
    echo "$dirty" | sed 's/^/      /'
    echo "    ./sonder codegen и закоммить результат"
    return 1
  fi

  echo "    совпадает с контрактами, сверено файлов ${#files[@]}"
}

cmd_verify() {
  need_docker
  local rc=0
  cmd_check_eol           || rc=1
  cmd_check_shell         || rc=1
  cmd_check_language      || rc=1
  cmd_contracts           || rc=1
  cmd_contracts_selftest  || rc=1
  cmd_check_drift         || rc=1
  cmd_check_generated     || rc=1
  cmd_check_node          || rc=1
  cmd_check_budgets       || rc=1
  cmd_check_layers        || rc=1
  # Свод входит в общий прогон: вход порождается, база не нужна, и
  # пакетная программа ломается так же тихо, как всё остальное.
  cmd_report_test         || rc=1
  # Длина записей свода — вторым мнением. База не нужна, входы
  # порождаются, идёт секунду.
  cmd_reclen_test         || rc=1
  cmd_check_schedule      || rc=1
  cmd_domain_crosscheck   || rc=1
  cmd_test                || rc=1
  # Java входит в verify с самого начала. Проверка, охватывающая половину
  # кодовой базы, уже один раз позволила регрессии просидеть несколько
  # коммитов: локально гонялись тесты, в CI — всё остальное.
  cmd_java                || rc=1
  # Фронт входит в общую проверку по той же причине, что и Java:
  # проверка, охватывающая половину кодовой базы, уже один раз позволила
  # регрессии просидеть несколько коммитов.
  cmd_web                 || rc=1
  echo
  if [ "$rc" -eq 0 ]; then
    echo "все проверки пройдены"
  else
    echo "ЕСТЬ ПРОВАЛЫ"
  fi
  return "$rc"
}

# Сгенерированный код обязан не только собираться, но и работать: раскладка
# записей может скомпилироваться и при этом оказаться нерабочей.
cmd_check_generated() {
  ensure_dos
  step "сгенерированный Pascal собирается и работает"
  run_dos bash dosnode/build/compile-generated.sh
}

# NODE-7 собирается под тот таргет, на котором поедет.
#
# Программа связывает все модули разом, и сломать её может изменение
# любого из них: подпись обработчика, размер записи, имя константы.
# Собирается она при этом только под i8086 — на нативном таргете нет ни
# часов BIOS, ни портов, — поэтому обычный дуальный прогон её не
# трогает, и без отдельного шага она тихо перестала бы собираться.
# Граф модулей Pascal: без циклов и без рёбер вверх.
#
# Паскалевский двойник ArchUnit. Для Java правило «домен не знает о
# Spring, JDBC и JAX-WS» проверялось с самого начала; для Pascal — где
# домен и живёт — такого правила не было, хотя здесь оно и главное:
# ядро есть чистая функция, и ввода-вывода в нём нет ПО ПОСТРОЕНИЮ.
# Утверждение это ничем не подкреплялось: дописать TcPort в uses
# доменного модуля собралось бы молча.
cmd_check_layers() {
  need_docker
  step "граф модулей Pascal"
  run_py python ops/ci/check-layers.py || return 1
}

# Бюджеты TURBOCORE §12 против констант кода.
#
# Три строки таблицы бюджетов помечены словами «проверка в CI», и
# проверки не было ни для одной: бюджет жил утверждением. Бюджет без
# проверки хуже отсутствующего — отсутствующий заставляет думать при
# каждом изменении, а заявленный и непроверяемый создаёт уверенность,
# что кто-то следит.
cmd_check_budgets() {
  need_docker
  step "бюджеты TURBOCORE §12"
  run_py python ops/ci/check-budgets.py || return 1
}

# Бюджет размера бинарника NODE-7, байт.
#
# 400 КБ объявлены в TURBOCORE.md §12 с пометкой «проверка в CI», и
# проверки этой не было: бюджет существовал утверждением. Найдено
# сверкой таблицы гейтов с действительностью, а не превышением — и это
# ровно тот случай, ради которого сверку и делают.
#
# Откуда предел. Программа целиком загружается в память под DOS, где её
# ждут 640 КБ на всё вместе с самой ОС; за 400 КБ остаётся слишком мало
# на дальнюю кучу, которой нужно 599 КБ под стеки файберов и арены
# каналов. Превышение означает не «файл потолстел», а «места под данные
# больше нет».
NODE7_MAX_BYTES=409600

cmd_check_node() {
  ensure_dos
  step "NODE-7 собирается под i8086-msdos"
  run_dos bash -c 'bash dosnode/build/build.sh --target msdos       --main dosnode/src/node7.pas --out NODE7 --outdir node'     || return 1

  local exe="$ROOT/dosnode/build/out/msdos-node/NODE7.EXE"
  if [ ! -f "$exe" ]; then
    echo "    СБОРКА НЕ ОСТАВИЛА БИНАРНИКА: $exe" >&2
    return 1
  fi

  # `wc -c`, а не `stat`: у GNU и BSD разные флаги, и проверка не должна
  # зависеть от того, чей coreutils подвернулся.
  local bytes
  bytes=$(wc -c < "$exe" | tr -d ' ')
  local pct=$(( bytes * 100 / NODE7_MAX_BYTES ))
  echo "    размер: $bytes Б из $NODE7_MAX_BYTES ($pct % бюджета)"
  if [ "$bytes" -gt "$NODE7_MAX_BYTES" ]; then
    echo "    БЮДЖЕТ РАЗМЕРА ПРЕВЫШЕН (TURBOCORE.md §12)" >&2
    return 1
  fi
}

# Тесты TurboCore на обоих таргетах. Расхождение между ними — дефект,
# а не особенность платформы: ради этого сравнения и существует дуальная
# сборка (ADR-0005). Первый же модуль оправдал её, поймав переполнение
# при выравнивании, которое 16-битный таргет проглатывал молча.
cmd_test() {
  ensure_dos
  step "тесты TurboCore на обоих таргетах"
  run_dos bash dosnode/build/test.sh both
}

cmd_test_native() {
  ensure_dos
  step "тесты TurboCore, нативный таргет"
  run_dos bash dosnode/build/test.sh native
}

# ------------------------------------------------------------------- спайки

cmd_spikes() {
  need_docker
  ensure_dos
  local rc=0
  step "S1: файберы, модель medium"
  run_dos bash spikes/s1-fibers/run.sh medium   || rc=1
  step "S1b: файберы в дальней куче, модель large"
  run_dos bash spikes/s1-fibers/run-b.sh large  || rc=1
  step "S2: последовательный транспорт"
  run_dos bash spikes/s2-transport/run.sh 1     || rc=1
  step "S3: устойчивость headless-прогона"
  run_dos bash spikes/s3-headless/run.sh 20     || rc=1
  step "S5: CORBA между контейнерами"
  bash spikes/s5-iiop/run.sh                    || rc=1
  echo
  [ "$rc" -eq 0 ] && echo "все спайки пройдены" || echo "ЕСТЬ ПРОВАЛЫ"
  return "$rc"
}

# ---------------------------------------------------------------------- java

# Сборка и тесты оболочки. Java 8 — ограничение проекта, а не выбор:
# восьмёрка последняя несёт CORBA в составе (ADR-0004). На хосте не
# устанавливается ничего, всё в контейнере.
cmd_java() {
  need_docker
  step "сборка и тесты Java"
  if [ $# -eq 0 ]; then
    bash ops/ci/mvn.sh verify
  else
    bash ops/ci/mvn.sh "$@"
  fi
}

# Интеграционные тесты оболочки: поднимают настоящий Firebird через
# Testcontainers. Отдельно от cmd_java, потому что требуют Docker внутри
# контейнера сборки, а обычная сборка обязана оставаться герметичной.
cmd_java_it() {
  need_docker
  step "интеграционные тесты оболочки"
  bash ops/ci/run-it.sh
}

# ------------------------------------------------------------------- фаззинг

# Долгий прогон фаззеров XML и кадрирования. В verify не входит: гейт
# требует суток, а проверка перед коммитом обязана укладываться в минуты.
# Аргументы прокидываются в dosnode/fuzz/soak.sh как есть.
cmd_web() {
  need_docker
  step "фронт: сборка и тесты"
  # Отдельным скриптом, а не строкой здесь: те же команды нужны и в CI,
  # и вызывать их оттуда через ./sonder значило бы завести зависимость
  # от этого файла ради двух строк.
  bash ops/ci/web.sh "${1:-test}" || return 1
}

cmd_up() {
  need_docker
  step "система целиком"
  # ПОРЯДОК СБОРКИ ЗАДАЁТСЯ ЗДЕСЬ. Бегунок ночного свода собирается из
  # двух готовых образов — оболочки и пакета, — чтобы не повторять их
  # рецепты третьей копией. Compose строит службы параллельно и порядка
  # не обещает: без этих двух строк сборка иногда встаёт на
  # `FROM sonder-app`, а иногда нет, в зависимости от того, кто успел.
  docker compose build app || return 1
  docker image inspect sonder/report:1 > /dev/null 2>&1     || docker build -f ops/compose/Dockerfile.report -t sonder/report:1 .     || return 1
