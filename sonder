# Сколько накоплено фаззинга. Гейт Ф5 требует суток, и «примерно
# столько-то» тут не годится: сумма берётся из журнала, куда soak.sh
# пишет каждый свой прогон.
cmd_soak_total() {
  local ledger="$ROOT/dosnode/fuzz/soak-log.tsv"
  step "накопленный фаззинг"
  if [ ! -f "$ledger" ]; then
    echo "    журнала нет: ни одного прогона не записано"
    return 1
  fi
  # Порог по DOSBox передаётся переменной, а не зашит в тело awk: так
  # его видно рядом с объяснением, а менять придётся вместе с ним.
  awk -F '\t' -v MIN_MSDOS=21600 '
    /^#/ { next }
    NF < 11 { next }
    {
      secs[$2] += $3; runs[$2] += $4;
      if ($6 > last[$2]) last[$2] = $6;
      total += $3; totalRuns += $4;
      if ($11 != "чисто") violations++;
      xml += $7 + $8; frames += $9;
    }
    END {
      for (t in secs)
        printf("    %-7s %6.2f ч, прогонов %d, семена пройдены до %d\n",
               t, secs[t] / 3600, runs[t], last[t]);
      printf("    ------\n");
      printf("    всего   %6.2f ч из 24, это %.1f%%\n",
             total / 3600, total / 864);
      printf("    из них под DOSBox %.2f ч из %g требуемых\n",
             secs["msdos"] / 3600, MIN_MSDOS / 3600);
      printf("    прогонов %d, XML разобрано %d, кадров сверено %d\n",
             totalRuns, xml, frames);

      bad = 0;
      if (violations > 0) {
        printf("    НАРУШЕНИЙ: %d — гейт не берётся\n", violations);
        bad = 1;
      } else
        printf("    нарушений нет\n");

      # ЧЕТВЕРТЬ ВРЕМЕНИ — ПОД ЭМУЛЯТОРОМ, и это не педантизм. Ядро
      # едет на i8086-msdos: там другая разрядность целых, другая
      # модель памяти и другое поведение переполнения. Дуальная сборка
      # (ADR-0005) заведена ровно потому, что таргеты расходятся, и
      # первый же модуль это оправдал.
      #
      # Сутки почти целиком нативного фаззинга удовлетворили бы БУКВУ
      # гейта, обойдя его смысл: проверен был бы не тот код, который
      # поедет. Порог поставлен четвертью, а не половиной, потому что
      # под DOSBox фаззер втрое медленнее по семенам, и половина
      # означала бы неделю машинного времени вместо суток.
      if (secs["msdos"] < MIN_MSDOS) {
        printf("    ПОД DOSBOX МАЛО: %.2f ч при пороге %g ч — проверен\n",
               secs["msdos"] / 3600, MIN_MSDOS / 3600);
        printf("    не тот таргет, который поедет\n");
        bad = 1;
      }
      if (total < 86400) {
        printf("    СУТКИ ЕЩЁ НЕ НАБРАНЫ\n");
        bad = 1;
      }
      exit bad;
    }
  ' "$ledger" || return 1

  # Пересечение диапазонов означает, что два прогона гоняли один и тот же
  # вход, а журнал засчитал это двумя независимыми отрезками: часы
  # настоящие, покрытие — нет. Так уже вышло дважды, пока фаззер можно
  # было запустить в двух экземплярах, и нашлось это не глазами.
  awk -F '\t' '
    /^#/ { next }
    NF < 11 { next }
    $6 < $5 { next }
    { print $5, $6, $1, $2 }
  ' "$ledger" | sort -n | awk '
    { if ($1 <= prev) {
        printf("    ПЕРЕСЕЧЕНИЕ семян %d..%d (%s %s) после %d\n",
               $1, $2, $3, $4, prev);
        bad++;
        waste += ((prev < $2) ? prev : $2) - $1 + 1
      }
      if ($2 > prev) prev = $2 }
    END {
      if (bad > 0) {
        printf("    диапазонов внахлёст: %d, семян впустую около %d\n", bad, waste);
        printf("    Часы настоящие, покрытие меньше на эту величину.\n");
        printf("    Новых пересечений не будет: фаззер берёт замок.\n");
      } else {
        printf("    диапазоны не пересекаются, семена пройдены до %d\n", prev)
      }
    }
  '
}

