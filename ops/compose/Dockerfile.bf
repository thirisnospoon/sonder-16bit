# Второе мнение о длине записей свода — на Brainfuck.
#
# ЗАЧЕМ ОТДЕЛЬНЫЙ ОБРАЗ. Проверка обязана не разделять с проверяемым
# ничего: ни локали, ни библиотек, ни версии awk. Ровно общая локаль и
# сделала предыдущую проверку неверной — `length()` в awk считает
# СИМВОЛЫ, и запись в 380 байт с шестью кириллическими буквами давала
# 374; проверка объявила негодными 6971 запись из 6972 при исправной
# выгрузке (ADR-0019).
#
# Здесь нет ни локали, ни кодировок, ни настроек: интерпретатор умеет
# прочитать байт и прибавить единицу. Образ поэтому нарочно пустой —
# Debian и один пакет.
#
# Версия зафиксирована названием образа Debian: поведение чтения ЗА
# КОНЦОМ ВХОДА соглашением языка не определено, и программа опирается на
# измеренное — этот интерпретатор не кладёт в ячейку ничего и прекращает
# программу с кодом возврата ноль. Подмена интерпретатора на другой
# сменила бы это молча, поэтому проверка ops/ci/reclen-test.sh измеряет
# конец входа заново при каждом прогоне.

FROM debian:12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends beef \
 && rm -rf /var/lib/apt/lists/*

# Программа порождается генератором из контракта свода; править её здесь
# нечего, и потому она кладётся в образ как есть.
COPY report/src/reclen.bf /usr/local/share/reclen.bf

# Вход — поток записей на stdin, выход — по отметке на запись.
# Ни путей, ни настроек: единственное, что программа умеет, она делает.
ENTRYPOINT ["beef", "/usr/local/share/reclen.bf"]
