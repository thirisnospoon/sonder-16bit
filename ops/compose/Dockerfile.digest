# Бегунок ночного свода: расписание, выгрузка, пакет.
#
# СОБИРАЕТСЯ ИЗ ДВУХ ГОТОВЫХ ОБРАЗОВ, а не повторяет их рецепты. Свод —
# это ровно образ пакета плюс возможность запустить выгрузку, и оба
# куска уже собраны: `sonder/report:1` несёт двоичный файл COBOL и его
# рантайм, `sonder-app` — jar оболочки с порождённым писателем записи и
# драйвером базы.
#
# Повторить здесь ступень Maven и вызов `cobc` было бы проще на один
# шаг и хуже навсегда: разошедшиеся копии одного рецепта — тот же класс
# дефекта, что и разошедшийся с кодом документ, и ловится он так же
# плохо. Цена решения — порядок сборки: оба образа обязаны существовать
# раньше этого. Порядок задаёт `./sonder up`, а не расчёт на удачу.
#
# ПОЧЕМУ ОДИН КОНТЕЙНЕР НА ОБА ШАГА. Выгрузка и пакет — разные
# программы на разных языках, и запускать второй шаг из первого значило
# бы дать ночному отчёту сокет Docker, то есть права root на хосте.
# ADR-0018 отделяет пакет от ОПЕРАТИВНОГО приложения; выгрузку от пакета
# он не отделяет, и делить их по контейнерам не за что.

FROM sonder-app AS shell

FROM sonder/report:1

# Рантайм Java 8 берётся из официального образа целиком: он
# самодостаточен и не требует пакетов сверх тех, что уже стоят. Debian
# 12 несёт glibc новее, чем база temurin, а glibc совместим снизу вверх
# — но «должно работать» тут не довод: `./sonder digest-schedule`
# спрашивает у собранного образа его версию Java и падает, если рантайм
# не запустился.
COPY --from=eclipse-temurin:8-jre /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/opt/java/openjdk/bin:${PATH}"

# Локаль задаётся, потому что её отсутствие уже испортило журнал. В
# голом Debian кодировка по умолчанию ASCII, и весь русский вывод
# выгрузки приезжал в `docker compose logs` вопросительными знаками:
# «??????: 2026-09-03 .. 2026-09-04». Ночью читать такое сообщение об
# отказе будет некому и нечем.
#
# C.UTF-8, а не ru_RU.UTF-8: нужна только кодировка, а не правила
# сортировки и форматы чисел — те как раз лучше оставить машинными.
#
# Ставится LANG, а не LC_ALL. LC_ALL — молоток, который бьёт по всему
# сразу; проверке длины записей нужен байтовый счёт, и она задаёт себе
# `LC_ALL=C` сама. Задать его же глобально значило бы завести вторую
# власть над тем самым понятием, из-за которого вся эта проверка и
# появилась.
ENV LANG=C.UTF-8

COPY --from=shell /app/sonder.jar /app/sonder.jar

# ВТОРОЕ МНЕНИЕ О ДЛИНЕ ЗАПИСЕЙ ЕДЕТ СЮДА ЖЕ (ADR-0019). Ночная выгрузка
# — та же программа, что и ручная, и ошибётся она так же; проверка,
# стоящая только на ручной дороге, стережёт ту из двух, за которой и так
# смотрят глазами.
#
# Интерпретатор ставится пакетом, программа кладётся порождённой, а
# контракт — тот самый, что диктует длину: разбирает его вердикт, и
# только он. Пакет невелик, и это дешевле, чем давать службе расписания
# право запускать чужие контейнеры.
RUN apt-get update \
 && apt-get install -y --no-install-recommends beef \
 && rm -rf /var/lib/apt/lists/*

COPY report/src/reclen.bf /usr/local/share/reclen.bf
COPY contracts/reports/digest-v1.yaml /etc/sonder/digest-v1.yaml
COPY ops/compose/reclen-verdict.sh /usr/local/bin/reclen-verdict
COPY ops/compose/digest-entrypoint.sh /usr/local/bin/digest-schedule

# Образ пакета объявляет свои пути входа и выхода; бегунок задаёт их
# сам на каждый прогон, и унаследованные значения только сбивали бы с
# толку при чтении `docker inspect`.
ENV SONDER_DIGEST_INPUT= \
    SONDER_DIGEST_OUTPUT= \
    SONDER_REPORT_DIR=/data \
    SONDER_DIGEST_AT=03:00

ENTRYPOINT ["/usr/local/bin/digest-schedule"]
