# Фронт: статика и обратный прокси к оболочке.
#
# Собирается TypeScript, отдаётся nginx. Сборщика нет: модули грузит сам
# браузер (ADR-0012), поэтому «сборка» здесь — это компиляция типов и
# ничего больше.

FROM node:20-alpine AS build
WORKDIR /web

COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY web/tsconfig.json ./
COPY web/src/ src/
RUN npm run build

FROM nginx:1.27-alpine
COPY ops/compose/nginx.conf /etc/nginx/conf.d/default.conf
COPY web/index.html web/styles.css /usr/share/nginx/html/
COPY --from=build /web/build /usr/share/nginx/html/build
EXPOSE 80
