# Второе мнение о доменных правилах — на Прологе.
#
# ЗАЧЕМ ОТДЕЛЬНЫЙ ОБРАЗ. Проверяющий не должен делить с проверяемым
# ничего: ни языка, ни библиотек, ни представления о том, что такое
# «верная строка». Ровно общее представление и делает вторую проверку
# бесполезной — она ошибается там же, где первая.
#
# Здесь нет ни Паскаля, ни Java: Debian и один пакет.

FROM debian:12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends swi-prolog-nox \
 && rm -rf /var/lib/apt/lists/*

# Локаль ради кодировки вывода: коды отказов и сообщения по-русски, а в
# голом Debian кодировка по умолчанию ASCII — расхождение приезжало бы в
# журнал вопросительными знаками ровно тогда, когда его надо прочесть.
ENV LANG=C.UTF-8

ENTRYPOINT ["swipl"]
