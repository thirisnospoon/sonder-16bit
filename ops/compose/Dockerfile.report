# Пакетный свод на COBOL.
#
# GnuCOBOL компилирует в C и собирает обычным cc — отдельного рантайма
# программе не нужно, получается исполняемый файл. Образ поэтому
# двухступенчатый: инструментарий остаётся на ступени сборки.
#
# Отдельный образ, а не добавка к оболочке: свод — пакет, он живёт своим
# расписанием и не должен делить с оперативным приложением ни память,
# ни время отклика (ADR-0018).

FROM debian:12-slim AS build

RUN apt-get update \
 && apt-get install -y --no-install-recommends gnucobol4 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY report/copybook/ copybook/
COPY report/src/ src/

# `-x` — исполняемый файл, а не модуль.
# `-I copybook` — где искать COPY.
# `-Wall` — предупреждения видны: разметка порождается, и предупреждение
#   о ней означает, что порождено не то.
#
# `-free` — СВОБОДНЫЙ ФОРМАТ, и это вынужденно, а не из моды.
#
# Столбцовый формат COBOL обрывает строку на 72-й колонке, и колонки эти
# считаются В БАЙТАХ. Заголовок отчёта по-русски — два байта на букву, и
# двадцать пять русских букв уже выходят за границу: компилятор
# отбрасывает хвост, литерал остаётся незакрытым и падает с «continuation
# character expected». Ровно это и произошло при первой сборке.
#
# Выбор был между свободным форматом и заголовками латиницей. Проект
# пишет по-русски везде — от комментариев в Паскале до сообщений об
# отказах, — и делать исключение ради колонок, придуманных под
# перфокарту, значит менять язык проекта под ограничение носителя,
# которого давно нет.
RUN cobc -x -free -Wall -I copybook -o /out-digest src/DIGEST.cbl

FROM debian:12-slim

# Рантайм GnuCOBOL нужен и на этой ступени: cobc линкует с libcob.
#
# Версия пакета обязана совпасть с версией компилятора. `gnucobol4`
# линкует с `libcob.so.5`, а пакет `libcob4` даёт четвёртую — первая
# сборка встала на «libcob.so.5: cannot open shared object file» при
# полностью исправном бинарнике. Цифра в имени пакета компилятора
# относится к версии стандарта COBOL, а не библиотеки, и совпадение
# цифр тут обманчиво.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libcob5 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /out-digest /usr/local/bin/digest

# Пути приходят переменными окружения: зашитые в программу, они сделали
# бы её непригодной ни для проверки, ни для второго запуска.
ENV SONDER_DIGEST_INPUT=/data/posts.dat \
    SONDER_DIGEST_OUTPUT=/data/digest.txt

ENTRYPOINT ["/usr/local/bin/digest"]
