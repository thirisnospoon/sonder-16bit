<?xml version="1.0" encoding="UTF-8"?>
<!--
  core — императивная оболочка.

  Всё, чего нет в доменном ядре: ввод-вывод, база, сессии, HTTP. Решения
  принимает NODE-7 (ADR-0011), здесь только загрузка состояния, вызов и
  сохранение результата.

  Отсутствие доменных правил в этом модуле — не пожелание, а проверка:
  ArchUnit ищет их и роняет сборку. См. ArchitectureTest.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>sonder</groupId>
    <artifactId>sonder-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>core</artifactId>
  <name>Sonder :: core</name>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.firebirdsql.jdbc</groupId>
      <artifactId>jaybird</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!--
      Поддержка Firebird лежит ОТДЕЛЬНЫМ артефактом, и без него Flyway
      отвечает «No database found to handle jdbc:firebirdsql:...» — как
      будто дело в URL или драйвере.

      С версии 8.2 Flyway вынес базы из flyway-core в отдельные модули;
      в самом core остались только те, что были там исторически. Проверено
      прямо: в flyway-core 8.5.13 и 9.22.3 нет ни одного класса с
      «firebird», как нет и mysql с sqlserver.
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-firebird</artifactId>
      <version>${flyway.version}</version>
    </dependency>

    <!-- SOAP-клиент к NODE-7. Contract-first: стабы порождаются из того
         же WSDL, из которого wsdl2pas порождает серверную сторону. -->
    <dependency>
      <groupId>org.apache.cxf</groupId>
      <artifactId>cxf-rt-frontend-jaxws</artifactId>
      <version>${cxf.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.cxf</groupId>
      <artifactId>cxf-rt-transports-http</artifactId>
      <version>${cxf.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!--
      Интеграционные тесты отдельным профилем, а не в каждой сборке.

      Им нужен Docker: они поднимают настоящий Firebird. Обычная сборка
      герметична и обязана оставаться такой — иначе она перестанет
      запускаться там, где Docker недоступен, и это выяснится не сразу.

      Запуск: ./sonder java-it
    -->
    <profile>
      <id>it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <useFile>false</useFile>
              <trimStackTrace>false</trimStackTrace>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
