<?xml version="1.0" encoding="UTF-8"?>
<!--
  core — императивная оболочка.

  Всё, чего нет в доменном ядре: ввод-вывод, база, сессии, HTTP. Решения
  принимает NODE-7 (ADR-0011), здесь только загрузка состояния, вызов и
  сохранение результата.

  Отсутствие доменных правил в этом модуле — не пожелание, а проверка:
  ArchUnit ищет их и роняет сборку. См. ArchitectureTest.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>sonder</groupId>
    <artifactId>sonder-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>core</artifactId>
  <name>Sonder :: core</name>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!--
      Актуатор нужен ради одного: у здоровья сервиса должно быть место,
      которое ищут первым. Своя ручка на /internal/node была бы тем же
      самым, только неизвестным ни одному оркестратору и ни одной
      проверке живости — и вдобавок обошла бы сверку маршрутов с
      OpenAPI, потому что лежала бы вне пакета, который та смотрит.

      Скрейпинг Prometheus — фаза 10; сюда он придёт как реестр
      micrometer, не потребовав ничего переписывать.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!--
      Только криптографический модуль Spring Security, не весь стартер.
      Нужен ровно BCrypt: своя реализация хэширования паролей — тот случай,
      когда «написать самому» означает написать хуже, и узнать об этом
      по утечке.
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <dependency>
      <groupId>org.firebirdsql.jdbc</groupId>
      <artifactId>jaybird</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!--
      Поддержка Firebird лежит ОТДЕЛЬНЫМ артефактом, и без него Flyway
      отвечает «No database found to handle jdbc:firebirdsql:...» — как
      будто дело в URL или драйвере.

      С версии 8.2 Flyway вынес базы из flyway-core в отдельные модули;
      в самом core остались только те, что были там исторически. Проверено
      прямо: в flyway-core 8.5.13 и 9.22.3 нет ни одного класса с
      «firebird», как нет и mysql с sqlserver.
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-firebird</artifactId>
      <version>${flyway.version}</version>
    </dependency>

    <!-- SOAP-клиент к NODE-7. Contract-first: стабы порождаются из того
         же WSDL, из которого wsdl2pas порождает серверную сторону. -->
    <dependency>
      <groupId>org.apache.cxf</groupId>
      <artifactId>cxf-rt-frontend-jaxws</artifactId>
      <version>${cxf.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.cxf</groupId>
      <artifactId>cxf-rt-transports-http</artifactId>
      <version>${cxf.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Клиент SOAP порождается из того же WSDL, из которого wsdl2pas
        порождает серверную сторону. Contract-first в обе стороны — это и
        есть главная причина, по которой в проекте вообще есть SOAP: из
        WSDL можно породить клиента для языка 1970 года.

        РЕЗУЛЬТАТ НЕ КОММИТИТСЯ, в отличие от сгенерированного Pascal, и
        это не непоследовательность. Pascal лежит в репозитории, чтобы его
        было видно на ревью, а расхождение с контрактом ловится проверкой
        дрейфа. Здесь проверять нечего: код порождается заново при каждой
        сборке из того же WSDL, и разойтись ему не с чем и негде.
      -->
      <plugin>
        <groupId>org.apache.cxf</groupId>
        <artifactId>cxf-codegen-plugin</artifactId>
        <version>${cxf.version}</version>
        <executions>
          <execution>
            <id>decider-client</id>
            <phase>generate-sources</phase>
            <goals><goal>wsdl2java</goal></goals>
            <configuration>
              <sourceRoot>${project.build.directory}/generated-sources/cxf</sourceRoot>
              <wsdlOptions>
                <wsdlOption>
                  <wsdl>${project.basedir}/../contracts/soap/decider-v1.wsdl</wsdl>
                  <extraargs>
                    <extraarg>-p</extraarg>
                    <extraarg>urn:sonder:decider:v1=sonder.contract.decider</extraarg>
                  </extraargs>
                </wsdlOption>
              </wsdlOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Обогащение событий порождается из contracts/idl/enrichment-v1.idl
        тем же idlj, что входит в состав JDK 8. Отдельного инструмента нет
        и не нужно: CORBA удалена из Java начиная с 11, и именно поэтому
        проект стоит на восьмёрке (ADR-0004).

        Порождаются обе стороны разом (-fall): скелет для core, который
        отвечает, и стаб для events, который спрашивает. Одна команда для
        двух сторон — то же самое contract-first, что с WSDL.

        РЕЗУЛЬТАТ НЕ КОММИТИТСЯ по той же причине, что и стабы CXF: он
        порождается заново при каждой сборке из того же IDL, и разойтись
        ему не с чем.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>enrichment-idl</id>
            <phase>generate-sources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${java.home}/../bin/idlj</executable>
              <arguments>
                <argument>-fall</argument>
                <argument>-td</argument>
                <argument>${project.build.directory}/generated-sources/idl</argument>
                <argument>${project.basedir}/../contracts/idl/enrichment-v1.idl</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        idlj кладёт исходники мимо стандартных каталогов, и сам по себе
        Maven о них не знает. Без этого шага сборка прошла бы зелёной, а
        классов обогащения в ней не было бы вовсе.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.4.0</version>
        <executions>
          <execution>
            <id>add-idl-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/generated-sources/idl</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Интеграционные тесты отдельным профилем, а не в каждой сборке.

      Им нужен Docker: они поднимают настоящий Firebird. Обычная сборка
      герметична и обязана оставаться такой — иначе она перестанет
      запускаться там, где Docker недоступен, и это выяснится не сразу.

      Запуск: ./sonder java-it
    -->
    <profile>
      <id>it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <useFile>false</useFile>
              <trimStackTrace>false</trimStackTrace>
              <!--
                Замеры из обычного прогона исключены. Тест отвечает «да»
                или «нет» и обязан укладываться в секунды; замер отвечает
                числом и занимает минуты. Держать их вместе значит либо
                замедлить прогон, либо занизить замер до бессмысленного.
                Запуск: ./sonder drain-bench
              -->
              <excludedGroups>bench</excludedGroups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
