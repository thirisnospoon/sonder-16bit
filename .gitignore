/spikes/*/out/
/dosnode/build/out/
*.ppu
*.o
*.a
*.exe
*.EXE
*.map
*.log

# локальные инструменты и кэши
/.tools/
/.cache/
node_modules/
target/
dist/

# среда
.env
.env.local
*.local

# редакторы
.idea/
.vscode/
*.swp
.DS_Store

# сборочные каталоги dosnode
/dosnode/build/out/
target/

# вывод сборки фронта: порождается из web/src, в версии не нужен
/web/build/

# вывод прогонов Playwright: снимки, трассы и отчёты падений.
# Это СЛЕДЫ прогона, а не его исходники: пересоздаются при каждом
# запуске, весят мегабайты и устаревают ровно в тот момент, когда
# падение исправлено.
/web/e2e/test-results/
/web/e2e/playwright-report/
/web/e2e/node_modules/

# отчёты Lighthouse: порождаются замером, в версии не нужны
/web/lighthouse/
